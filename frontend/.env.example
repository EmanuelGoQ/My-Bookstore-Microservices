# Frontend build-time configuration (Vite).
#
# VITE_API_BASE_URL: base URL the SPA uses for every API call.
#   - Local dev (vite proxy): "/"  (see VITE_DEV_API_TARGET below)
#   - Cloudflare Pages deploy: the HTTPS URL of the backend, e.g. the Cloudflare
#     Tunnel hostname that fronts the EKS LoadBalancer:
#       https://api.bookstore-eafit.example
#     It MUST be https:// because the SPA is served over https (no mixed content).
VITE_API_BASE_URL=/
VITE_API_PREFIX=/api
VITE_DEV_API_TARGET=http://localhost:5001
VITE_DEV_SERVER_PORT=3000
VITE_CURRENCY_LOCALE=es-CO
VITE_CURRENCY_CODE=COP
