NODE_ENV=development
SERVICE_NAME=catalog-service
PORT=5001
API_BASE_PATH=/api
CORS_ORIGINS=http://localhost:3000
HTTP_TRUST_PROXY_HOPS=1
HTTP_JSON_BODY_LIMIT=32kb

BOOKS_DEFAULT_LIMIT=24
BOOKS_MAX_LIMIT=100

# gRPC server (CatalogService)
GRPC_HOST=0.0.0.0
GRPC_PORT=50051

ACCESS_LOG_ENABLED=true
ACCESS_LOG_EXCLUDE_PATHS=/health
ACCESS_LOG_MAX_FIELD_LENGTH=2048
ACCESS_LOG_REQUEST_ID_HEADER=X-Request-Id
CLICKSTREAM_FILE_ENABLED=false
CLICKSTREAM_FILE_PATH=/usr/src/app/logs/clickstream.log

# Database-per-service: catalog owns the books database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=catalog
DB_USER=catalog_app
DB_PASSWORD=change_me_for_local_development
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
